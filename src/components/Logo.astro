---
/**
 * Site logo (Candor Concrete wordmark). SVG lives in /public.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a href="/" class={`inline-flex items-center ${className}`} aria-label="Candor Concrete, home">
  <img
    src="/candorLogo.svg"
    alt="Candor Concrete"
    width="166"
    height="59"
    class="h-11 w-auto sm:h-12"
  />
</a>
