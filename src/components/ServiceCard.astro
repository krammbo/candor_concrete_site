---
interface Props {
  title: string;
  summary: string;
  href: string;
  image?: string;
  imageAlt?: string;
}
const { title, summary, href, image, imageAlt } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg bg-cream border border-sand-dark transition-shadow hover:shadow-lg"
>
  <div class="aspect-[4/3] overflow-hidden bg-sand">
    {
      image ? (
        <img
          src={image}
          alt={imageAlt ?? title}
          width="600"
          height="450"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-orange to-orange-dark">
          <span class="font-display text-2xl text-cream/90 px-4 text-center">{title}</span>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-xl text-ink group-hover:text-orange transition-colors">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{summary}</p>
    <span class="mt-4 text-sm font-semibold uppercase tracking-wide text-orange">
      Learn more →
    </span>
  </div>
</a>
