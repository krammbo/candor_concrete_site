---
/**
 * Trust badges (veteran owned, licensed, BBB A+). Displayed as a strip under
 * the hero to build credibility above the fold.
 */
---

<section class="border-y border-sand-dark bg-sand-light">
  <div class="container-wide flex flex-wrap items-center justify-center gap-x-10 gap-y-4 py-5">
    {/* Veteran Owned */}
    <div class="flex items-center gap-2.5">
      <svg class="text-orange" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.42l-5.81 3.05 1.11-6.47-4.7-4.58 6.5-.95z" />
      </svg>
      <span class="font-display text-base sm:text-lg uppercase tracking-wide text-ink">Veteran Owned</span>
    </div>

    {/* Licensed Contractor */}
    <div class="flex items-center gap-2.5">
      <svg class="text-orange" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2l7 3v6c0 4.6-3.1 7.6-7 9-3.9-1.4-7-4.4-7-9V5z" />
        <path d="M9 12l2 2 4-4" />
      </svg>
      <span class="font-display text-base sm:text-lg uppercase tracking-wide text-ink">Licensed Contractor</span>
    </div>

    {/* BBB A+ Rating */}
    <div class="flex items-center gap-2.5">
      <svg class="text-orange" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M8.5 12l2.3 2.3 4.7-4.7" />
      </svg>
      <span class="font-display text-base sm:text-lg uppercase tracking-wide text-ink">A+ Rating with the BBB</span>
    </div>
  </div>
</section>
