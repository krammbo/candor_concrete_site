---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page Not Found" description="The page you’re looking for isn’t here." noindex={true}>
  <section class="container-wide py-24 text-center">
    <p class="script-accent text-2xl">Oops</p>
    <h1 class="mt-2 text-5xl">Page Not Found</h1>
    <p class="mx-auto mt-4 max-w-lg text-ink-soft">
      The page you’re looking for doesn’t exist or has moved. Let’s get you back on solid ground.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
      <Button href="/">Back to Home</Button>
      <Button href="/services/" variant="outline">View Services</Button>
    </div>
  </section>
</BaseLayout>
