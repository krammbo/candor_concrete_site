---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const services = (await getCollection('services')).filter((s) => !s.data.draft);
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Per-service Service + FAQPage structured data.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  description: d.summary,
  serviceType: d.title,
  provider: { '@id': `${Astro.site}#business` },
  areaServed: { '@type': 'City', name: 'Greenville, SC' },
  url: new URL(`/services/${entry.id}/`, Astro.site).toString(),
};

const faqSchema =
  d.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;
---

<BaseLayout
  title={d.seoTitle ?? `${d.title} | Greenville, SC`}
  description={d.seoDescription ?? d.summary}
  image={d.image}
  type="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Hero -->
  <section class="bg-ink text-cream">
    <div class="container-wide py-14">
      <nav class="text-sm text-cream/70" aria-label="Breadcrumb">
        <a href="/services/" class="hover:text-orange">Services</a>
        <span class="mx-1">/</span>
        <span>{d.title}</span>
      </nav>
      <h1 class="mt-3 text-4xl sm:text-5xl text-cream">{d.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-cream/85">{d.summary}</p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <Button href="/contact/">Get a Free Estimate</Button>
        <Button href={site.phoneHref} variant="outline" class="!border-cream !text-cream hover:!bg-cream hover:!text-ink">
          Call {site.phone}
        </Button>
      </div>
    </div>
  </section>

  <div class="container-wide grid gap-12 py-16 lg:grid-cols-[1.6fr_1fr] lg:items-start">
    <!-- Body copy -->
    <article class="prose-candor max-w-none">
      {d.image && (
        <img src={d.image} alt={d.imageAlt ?? d.title} width="900" height="600"
          class="mb-8 aspect-[3/2] w-full rounded-lg object-cover" />
      )}
      <div class="space-y-4 text-lg leading-relaxed text-ink-soft [&>h2]:mt-8 [&>h2]:mb-3 [&>h2]:text-2xl">
        <Content />
      </div>

      {
        d.faqs.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl sm:text-3xl">Frequently Asked Questions</h2>
            <div class="mt-6 divide-y divide-sand-dark border-t border-sand-dark">
              {d.faqs.map((f) => (
                <details class="group py-4">
                  <summary class="cursor-pointer list-none font-semibold text-ink flex items-center justify-between gap-4">
                    {f.question}
                    <span class="text-orange transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
                  </summary>
                  <p class="mt-3 text-ink-soft leading-relaxed">{f.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }
    </article>

    <!-- Sidebar -->
    <aside class="space-y-6 lg:sticky lg:top-24">
      {
        d.features.length > 0 && (
          <div class="rounded-lg border border-sand-dark bg-sand-light p-6">
            <h2 class="text-xl text-ink">What’s Included</h2>
            <ul class="mt-4 space-y-2">
              {d.features.map((f) => (
                <li class="flex gap-2 text-ink-soft">
                  <span class="mt-1 text-orange" aria-hidden="true">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="rounded-lg bg-ink text-cream p-6">
        <h2 class="text-xl text-cream">Get a Free Estimate</h2>
        <p class="mt-2 text-sm text-cream/80">Honest pricing and quality work. Reach out today.</p>
        <div class="mt-4 flex flex-col gap-2">
          <Button href="/contact/">Request Estimate</Button>
          <a href={site.phoneHref} class="text-center font-bold text-orange hover:text-cream">{site.phone}</a>
        </div>
      </div>
    </aside>
  </div>

  <CtaBand />
</BaseLayout>
