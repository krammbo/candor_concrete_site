---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Thank You | Candor Concrete"
  description="Thanks for reaching out to Candor Concrete. We’ll be in touch shortly."
  noindex={true}
>
  <section class="container-wide py-24 text-center">
    <h1 class="text-4xl sm:text-5xl">Thank You!</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-soft">
      We’ve received your request and will get back to you soon with your free
      estimate. Need to reach us sooner? Give us a call.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
      <Button href={site.phoneHref}>Call {site.phone}</Button>
      <Button href="/" variant="outline">Back to Home</Button>
    </div>
  </section>
</BaseLayout>
